{
  "name": "@bank-ai/local-runtime",
  "version": "0.5.4",
  "private": true,
  "type": "module",
  "exports": {
    "./app": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "default": "./dist/provider.js"
    },
    "./https-options": {
      "types": "./dist/https-options.d.ts",
      "default": "./dist/https-options.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts",
    "eval": "tsx src/evals/run.ts"
  },
  "dependencies": {
    "@bank-ai/contracts": "0.5.4",
    "cors": "^2.8.5",
    "diff": "^9.0.0",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "nspell": "^2.1.5",
    "office-addin-dev-certs": "^2.0.10",
    "openai": "^5.12.2",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.2.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
